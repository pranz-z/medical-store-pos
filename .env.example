# =============================================================================
# Medical Store POS - environment variables
# Copy this file to .env.local for local development:  cp .env.example .env.local
# Never commit real secrets. Values below are placeholders.
# =============================================================================

# libSQL / Turso database URL.
#   Local development : file:local.db
#   Production/Preview: libsql://<database>-<org>.turso.io  (from `turso db show`)
TURSO_DATABASE_URL="file:local.db"

# Turso auth token. Required for remote (libsql://) databases; leave empty for local files.
# Create a least-privilege token:  turso db tokens create <database>
TURSO_AUTH_TOKEN=""

# Auth.js/Better Auth secret used to sign session cookies.
# Generate with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Vercel Blob read/write token (prescription scans, backup dumps). Reserved for later milestones.
BLOB_READ_WRITE_TOKEN=""

# Sentry DSN for error reporting. Reserved for later milestones.
SENTRY_DSN=""

# Shared secret for Vercel Cron endpoints (nightly jobs). Reserved for later milestones.
CRON_SECRET=""

# IANA timezone used for receipt dates and report day boundaries.
APP_TIMEZONE="Asia/Manila"
